# Template only. Copy to an ignored .env and replace passwords locally.
# Development defaults below. Production values are listed in docs/database.md.
COMPOSE_PROJECT_NAME=itmowidgets-dev
APP_CONTAINER_NAME=itmowidgets-dev
DB_CONTAINER_NAME=itmowidgets-dev-db
BACKEND_IMAGE=itmowidgets-dev-backend:postgres
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=itmowidgets
DB_USER=itmowidgets
POSTGRES_ADMIN_PASSWORD=replace-with-unique-administrator-password
DB_PASSWORD=replace-with-different-application-password
DB_HOST_PORT=3301
POSTGRES_DATA_DIR=/mnt/raid/srv/dbs/itmowidgets-dev-postgres
FIREBASE_KEY_FILE=/mnt/raid/srv/web/itmowidgets-dev/firebase-postgres.json
LOCAL_POSTGRES_PORT=55432
APP_VERSION=2.1
MIN_APP_VERSION=2.1
APP_VERSION_NOTE=
# REQUIRED before the first backend start against a fresh database: a valid
# environment-specific technical-account seed, not a user's token. Optional only
# after a valid credential is persisted; then remove the stale seed and recreate
# the backend container. See docs/database.md before starting the application.
MY_ITMO_REFRESH_TOKEN=
