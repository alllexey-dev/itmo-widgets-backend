# Template only. Copy to an ignored .env and replace passwords locally.
# Development defaults below. Production values are listed in docs/ops/database.md.
COMPOSE_PROJECT_NAME=itmowidgets-dev
APP_CONTAINER_NAME=itmowidgets-dev
DB_CONTAINER_NAME=itmowidgets-dev-db
GEMINI_PROXY_CONTAINER_NAME=itmowidgets-dev-gemini-proxy
BACKEND_IMAGE=itmowidgets-dev-backend:postgres
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=itmowidgets
DB_USER=itmowidgets
POSTGRES_ADMIN_PASSWORD=replace-with-unique-administrator-password
DB_PASSWORD=replace-with-different-application-password
DB_HOST_PORT=3301
POSTGRES_DATA_DIR=/mnt/raid/srv/dbs/itmowidgets-dev-postgres
FIREBASE_KEY_FILE=/mnt/raid/srv/web/itmowidgets-dev/firebase-postgres.json
LOCAL_POSTGRES_PORT=55432
APP_VERSION=2.1
MIN_APP_VERSION=2.1
APP_VERSION_NOTE=
# Daily sync of legacy teacher reviews from reviews.work.gd; on for development only.
REVIEWS_SYNC_ENABLED=true
# REQUIRED before the first backend start against a fresh database: a valid
# environment-specific technical-account seed, not a user's token. It seeds the
# MY_ITMO_REFRESH_TOKEN row of service_credentials and is written only into a row
# without a value. After the first successful token refresh remove it and recreate
# the backend container. See docs/ops/database.md before starting the application
# and docs/ops/service-credentials.md for details.
MY_ITMO_REFRESH_TOKEN=
# Optional: the ISU KEYCLOAK_IDENTITY cookie of the technical account for the
# "taught the author" check of teacher reviews. It seeds the ISU_KEYCLOAK_IDENTITY
# row of service_credentials and is written only into a row without a value. After
# the first successful ISU login remove it and recreate the backend container.
# See docs/ops/service-credentials.md for details.
ISU_KEYCLOAK_IDENTITY=
# AI summaries of teacher reviews through Gemini via the gemini-proxy sidecar; off until the proxy
# config and the key are in place.
AI_SUMMARY_ENABLED=false
# Values from the probe, see docs/ops/ai-summaries.md.
GEMINI_MODEL=
AI_SUMMARY_DAILY_BUDGET=
AI_SUMMARY_REQUEST_DELAY=
GEMINI_THINKING_BUDGET=
GEMINI_MAX_OUTPUT_TOKENS=2048
# Optional: the Gemini API key from Google AI Studio. It seeds the GEMINI_API_KEY row of
# service_credentials and is written only into a row without a value. After the first
# successful Gemini request remove it and recreate the backend container.
# See docs/ops/service-credentials.md for details.
GEMINI_API_KEY=
